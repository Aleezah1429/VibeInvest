# VibeInvest environment variables — copy to .env and fill in real values.
# .env is gitignored; never commit real keys. These same vars are also set in
# your host's dashboard (Hugging Face Space secrets / Koyeb / Render / etc.).

# ── LLM + tools (backend) ───────────────────────────────────────────────
# Anthropic key powers all 4 agents. (ANTHROPIC_API_KEY also accepted.)
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Tavily powers the agents' web search.
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Google key (Gemini fallback / Google sign-in).
GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Optional — only if you wire an OpenAI path. Currently unused by the pipeline.
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# ── CORS (backend) ──────────────────────────────────────────────────────
# Comma-separated allowed origins, or "*" for all (simplest for a demo).
ALLOWED_ORIGINS=*

# ── Optional model/timeout overrides (backend) ──────────────────────────
# LLM_PROVIDER=claude
# CLAUDE_MODEL=claude-sonnet-4-5
# CLAUDE_MODEL_CVO=claude-opus-4-5
# PIPELINE_TIMEOUT_SEC=180
# AGENT_TIMEOUT_SEC=60

# ── Frontend (Expo) ─────────────────────────────────────────────────────
# Public URL of the deployed backend the app talks to. Update after deploy.
EXPO_PUBLIC_API_BASE_URL=https://your-backend-url.example.com
# Keep Expo from hitting the network for telemetry during local dev.
EXPO_OFFLINE=1
