# VibeInvest — google-adk-agent environment template.
# Copy this file to `.env` and fill in your real values. The `.env` file is
# gitignored. Never commit real keys.

# Required — Gemini auth for ADK agents (Skeptic, Munshi, Hype, CVO).
# Get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Required — comma-separated list of allowed CORS origins for the FastAPI app.
# Local dev: http://localhost:3000
# Add your Vercel deploy URL once frontend is deployed.
ALLOWED_ORIGINS=http://localhost:3000
